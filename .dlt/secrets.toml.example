# dlt secrets template
# Copy to .dlt/secrets.toml if you prefer TOML-based secrets over .env

[destination.filesystem.credentials]
azure_storage_account_name = "onelake"
azure_account_host = "onelake.blob.fabric.microsoft.com"
# Optional Service Principal credentials (leave omitted if using az login):
# azure_tenant_id = "00000000-0000-0000-0000-000000000000"
# azure_client_id = "00000000-0000-0000-0000-000000000000"
# azure_client_secret = "your_service_principal_secret"
