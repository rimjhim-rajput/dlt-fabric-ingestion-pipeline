# ==============================================================================
# Pipeline Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Active execution environment: 'local' (DuckDB), 'local_filesystem', or 'fabric' (OneLake)
PIPELINE_ENV=local

# ------------------------------------------------------------------------------
# Destination Configuration: Microsoft Fabric OneLake (60-day Free Trial)
# ------------------------------------------------------------------------------
# HOW TO CONFIGURE FOR 60-DAY FABRIC FREE TRIAL (ORGANIZATIONAL ACCOUNT):
# 1. In Microsoft Fabric (app.fabric.microsoft.com), create a Lakehouse (e.g. 'ecommerce_lakehouse').
# 2. Right-click the 'Files' folder in your Lakehouse -> click 'Properties' -> copy 'ABFS path'.
# 3. Paste that copied path below into FABRIC_ONELAKE_ABFS_PATH.
# 4. In your local terminal, run 'az login' and sign in with your organizational account.
# 5. You do NOT need any client ID or secret! The pipeline will use your az login token.

FABRIC_ONELAKE_ABFS_PATH=abfss://your-workspace-guid@onelake.dfs.fabric.microsoft.com/your-lakehouse-guid/Files/bronze/ecommerce

# Alternatively, if you prefer entering GUIDs separately instead of the full path:
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# Optional: Azure Entra ID Service Principal (Only for Enterprise / Production)
# Leave these commented out or blank if you are using your Free Trial account via az login!
# ------------------------------------------------------------------------------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# General Runtime & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DLT_TELEMETRY=false
